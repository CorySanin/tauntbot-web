<title><%= page.title %> | <%= page.titlesuffix %></title>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="og:title" content="<%= page.title%> | <%= page.titlesuffix%>" />
<% if (page.description) { %>
<meta name="description" content="<%= page.description%>" />
<meta name="og:description" content="<%= page.description%>" />
<% } %>
<% if (page.image) { %>
<meta name="og:image" content="<%= page.image%>"/>
<link rel="image_src" href="<%= page.image%>"/>
<% } %>
<% if (page.canonical) { %>
<link rel="canonical" href="<%= page.canonical%>"/>
<% } %>
<link rel="icon" type="image/png" href="/assets/icons/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/assets/icons/favicon.svg" />
<link rel="shortcut icon" href="/assets/icons/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="Taunt Bot" />
<link rel="manifest" href="/assets/icons/site.webmanifest" />
<link rel="prefetch" href="/assets/fonts/Space_Grotesk/SpaceGrotesk-VariableFont_wght.ttf" fetchpriority="low">
<link rel="prefetch" href="/assets/fonts/Zen_Dots/ZenDots-Regular.ttf" fetchpriority="low">
<link rel="prefetch" href="/assets/audio/fluxer/user-join.mp3" fetchpriority="low">
<link rel="prefetch" href="/assets/audio/fluxer/user-leave.mp3" fetchpriority="low">
<link rel="prefetch" href="/assets/audio/noise-maker.mp3" fetchpriority="low">
<link rel="prefetch" href="/assets/audio/sad_trombone.mp3" fetchpriority="low">
<link rel="prefetch" href="/assets/audio/wano.mp3" fetchpriority="low">
<link rel="stylesheet" href="/assets/css/lazy.css?v1" media="print" onload="this.media='all'">
<noscript>
  <link rel="stylesheet" href="/assets/css/lazy.css?v1">
</noscript>
<style>
    <%- inliner('assets/css/styles.css') %>
</style>
<script nonce="<%= cspNonce %>">
    document.addEventListener("DOMContentLoaded", function() {
        document.body.classList.remove('preload');
    });
</script>
